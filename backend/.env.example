PORT=5000
MONGO_URI=mongodb://localhost:27017/trading-bot

# Exchange settings (ccxt) - defaults are safe: sandbox + paper trading
EXCHANGE=binance
API_KEY=your_testnet_api_key
API_SECRET=your_testnet_api_secret
USE_SANDBOX=true

# Strategy settings
SYMBOL=BTC/USDT
TIMEFRAME=5m
FAST_SMA=9
SLOW_SMA=21
TRADE_AMOUNT_USDT=50

# Safety switch: keep false until you have tested thoroughly on sandbox/paper
LIVE_TRADING=false

# How often the bot checks for a signal (cron syntax)
POLL_INTERVAL_CRON=*/1 * * * *
